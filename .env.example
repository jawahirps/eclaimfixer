# DHA eClaim Portal Automation Configuration
# Copy this file to .env and fill in your actual values

# Portal URL (e.g., https://portal.dha.gov/eclaim)
PORTAL_URL=https://portal.dha.gov/eclaim

# Portal login credentials
PORTAL_USER=your_username
PORTAL_PASS=your_password

# Browser settings
# Set to False for debugging (see browser window), True for headless mode
HEADLESS=False

# Delay between claims in seconds (to avoid rate limiting)
DELAY_SECS=1.5
